# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Gere uma chave nova: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,seudominio.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://seudominio.com.br
DJANGO_SECURE_COOKIES=True
DJANGO_LOG_LEVEL=INFO

# Superusuário criado no primeiro boot (opcional; remova após criar o seu)
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha
DJANGO_SUPERUSER_NAME=Administrador

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=ieducar
POSTGRES_USER=ieducar
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Infra local
# ---------------------------------------------------------------------------
FRONTEND_PORT=8080
